PORT=3000
JWT_SECRET=change-me-to-a-long-random-string
# 本地默认用 SQLite（data/campus.db）
DATABASE_PATH=./data/campus.db
# 线上（Render）填 Supabase 连接串后会自动改用 PostgreSQL，本地不要填
# DATABASE_URL=postgresql://postgres:密码@db.xxx.supabase.co:5432/postgres
# 允许访问的前端域名（Vercel 地址），多个用逗号分隔
# FRONTEND_ORIGIN=https://xxx.vercel.app
# 管理员学号，逗号分隔；若库中尚无管理员，第一个注册用户会自动成为管理员
# ADMIN_STUDENT_IDS=2022123401

# 学习通定时推送：Vercel Cron / 手动调用 /api/chaoxing/cron 时校验
# CRON_SECRET=换成足够长的随机串
# 本地常驻进程间隔毫秒（默认 6 小时）；设 CHAOXING_CRON_DISABLE=1 可关掉
# CHAOXING_CRON_MS=21600000
